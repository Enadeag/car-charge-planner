<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

  <!-- the forecasts and the place search; AndroidHttpGet is the one class that connects -->
  <uses-permission android:name="android.permission.INTERNET" />
  <!-- the notifications, which Android 13 and later ask the owner for; the dashboard's card asks -->
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <!-- the round after the phone starts, which sets the alarm for the next notice again -->
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
  <!-- WorkManager's own, for work in the foreground, which the app never asks for -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" tools:node="remove" />

  <!-- enableOnBackInvokedCallback: the predictive back gesture, which Android 13 and later have (tools:targetApi) -->
  <application
      android:name=".CarChargePlannerApp"
      android:allowBackup="false"
      android:dataExtractionRules="@xml/data_extraction_rules"
      android:enableOnBackInvokedCallback="true"
      tools:targetApi="33"
      android:fullBackupContent="@xml/backup_rules"
      android:networkSecurityConfig="@xml/network_security_config"
      android:icon="@mipmap/ic_launcher"
      android:label="@string/app_name"
      android:supportsRtl="true"
      android:theme="@style/Theme.CarChargePlanner">
    <!-- singleTop: a notification's tap reaches the activity shown, through onNewIntent, rather than a second one -->
    <activity
        android:name=".MainActivity"
        android:exported="true"
        android:launchMode="singleTop">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity>
    <!-- the alarm for the next notice; only the app's own alarm reaches it -->
    <receiver
        android:name=".background.NoticeAlarmReceiver"
        android:exported="false" />
    <!-- exported for the system's broadcasts after the phone starts and after an update of the app only -->
    <receiver
        android:name=".background.BootReceiver"
        android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.BOOT_COMPLETED" />
        <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
      </intent-filter>
    </receiver>
    <service
        android:name="androidx.work.impl.foreground.SystemForegroundService"
        tools:node="remove" />
  </application>

</manifest>

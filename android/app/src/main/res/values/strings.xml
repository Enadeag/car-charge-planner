  <string name="place_chosen">Coordinates and time zone of %1$s filled in.</string>
  <!-- %1$s what the owner searched for -->
  <string name="place_none">No places found for “%1$s”.</string>
  <string name="place_no_search">Your forecast provider has no place search: enter the coordinates.</string>
  <string name="place_too_short">Type at least two letters or digits.</string>
  <string name="place_unavailable">The place search could not be reached. Check that the phone is online and try again, or enter the coordinates.</string>
  <string name="place_busy">The place search is busy. Try again in a minute.</string>
  <string name="place_bad_response">The place search gave an answer the app does not understand.</string>
  <string name="coordinates_toggle">Enter coordinates instead</string>
  <string name="latitude">Latitude</string>
  <string name="latitude_hint">Degrees; positive is north.</string>
  <string name="longitude">Longitude</string>
  <string name="longitude_hint">Degrees; positive is east of Greenwich.</string>
  <string name="advanced">Advanced</string>

  <string name="time_zone_now">Time zone: %1$s</string>
  <string name="time_zone_change">Change the time zone</string>
  <string name="time_zone_title">Time zone</string>
  <string name="time_zone_filter">Search the time zones</string>
  <string name="time_zone_none">No time zone matches.</string>

  <string name="setup_panels_title">Your solar panels</string>
  <string name="setup_panels_intro">Enter the panels that share one tilt and one direction. Panels that face another way are added in Settings, as an array of their own.</string>
  <string name="panel_size">Size</string>
  <string name="panel_size_hint">kWp: the peak power of the panels together.</string>
  <string name="panel_tilt">Tilt</string>
  <string name="panel_tilt_hint">Degrees from flat: 0 is flat, about 35 for a pitched roof.</string>
  <string name="panel_direction">Direction</string>
  <string name="panel_direction_hint">Degrees from south: -90 is east, 90 is west.</string>
  <string name="panel_losses">System losses</string>
  <string name="panel_losses_hint">Percent, usually 10 to 15.</string>

  <string name="setup_car_title">Your car</string>
  <string name="car_battery">Usable battery</string>
  <string name="car_battery_hint">kWh, usually 40 to 100.</string>
  <string name="car_consumption">Consumption</string>
  <string name="car_consumption_hint">kWh per 100 km, usually 14 to 22.</string>
  <string name="car_other_driving">Other driving per day</string>
  <string name="car_other_driving_hint">km a day of the short drives that are not trips.</string>
  <string name="car_trip_surcharge">Trip surcharge</string>
  <string name="car_trip_surcharge_hint">Percent added to the consumption for a trip\'s energy.</string>

  <string name="setup_charger_title">Your charger</string>
  <string name="charger_phases">Phases</string>
  <string name="charger_phases_hint">One or three: the charger\'s label or manual says.</string>
  <string name="phases_one">One phase</string>
  <string name="phases_three">Three phases</string>
  <string name="charger_min_current">Minimum charge current</string>
  <string name="charger_min_current_hint">A per phase, often 6.</string>
  <string name="charger_max_current">Maximum charge current</string>
  <string name="charger_max_current_hint">A per phase, often 16 or 32.</string>
  <string name="charger_voltage">Voltage</string>
  <string name="charger_voltage_hint">V, usually 230.</string>
  <string name="charger_efficiency">Charging efficiency</string>
  <string name="charger_efficiency_hint">Percent, usually about 90.</string>

  <string name="setup_more_title">House and away periods</string>
  <string name="setup_more_intro">Both are optional: they make the plan better, and you can also set them later in Settings. If you drive to work, add the periods the car is away.</string>
  <string name="house_heading">House</string>
  <string name="baseload">House baseload</string>
  <string name="baseload_hint">kW without the car: a month\'s kWh divided by 730.</string>
  <string name="away_heading">Weekly away periods</string>
  <string name="away_none">None: the car is treated as at home all week.</string>
  <string name="away_add">Add period</string>
  <!-- %1$d the period's place in the list, from 1 -->
  <string name="away_period">Away period %1$d</string>
  <!-- %1$d the period's place in the list, from 1 -->
  <string name="away_remove">Remove away period %1$d</string>
  <!-- %1$d the period's place in the list, from 1, so a screen reader names the period with each field -->
  <string name="away_weekday">Weekday, period %1$d</string>
  <!-- %1$d the period's place in the list, from 1 -->
  <string name="away_from">Away from, period %1$d</string>
  <!-- %1$d the period's place in the list, from 1 -->
  <string name="away_until">Away until, period %1$d</string>
  <string name="time_hint">Hours and minutes, such as 08:00.</string>

  <string name="setup_check_title">Check the forecast</string>
  <string name="setup_check_intro">The app asks for one forecast with what you entered, so you know it works before you finish. Nothing is saved yet.</string>
  <!-- %1$s the forecast provider's name, such as Open-Meteo -->
  <string name="check_asking">Asking %1$s for a forecast for your home…</string>
  <!-- %1$s the forecast provider's name, such as Open-Meteo; %2$d the days of forecast, 0 or more -->
  <plurals name="check_works">
    <item quantity="one">Forecast received from %1$s, %2$d day.</item>
    <item quantity="other">Forecast received from %1$s, %2$d days.</item>
  </plurals>
  <string name="check_failed">No forecast received. You can still finish: the Today screen asks for one again when it opens.</string>
  <string name="check_again">Check again</string>
  <string name="finish_saving">Saving…</string>
  <string name="finish_failed">Not saved: the settings could not be written.</string>

  <string name="problem_out_of_range">This value is outside what is allowed here.</string>
  <string name="problem_not_below_target">Must be below the target charge level.</string>
  <string name="problem_below_minimum_current">Must not be below the minimum charge current.</string>
  <string name="problem_same_as_primary">Choose a different provider from the first one.</string>
  <string name="problem_not_after_start">Must end after it starts, on the same day.</string>
  <string name="problem_same_as_start">Choose two different times.</string>
  <string name="problem_not_a_number">Type a number.</string>
  <string name="problem_not_a_whole_number">Type a whole number, without decimals.</string>
  <string name="problem_not_a_time">Type the time as hours and minutes, such as 07:30.</string>
  <string name="problem_required">Required: this provider cannot be asked without it.</string>

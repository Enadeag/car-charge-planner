  <string name="problem_letters_and_digits">Use only letters and digits, at most 64: that is what the provider\'s API keys look like.</string>
  <string name="problem_one_line">Use one line, without line breaks or other control characters.</string>
  <string name="problem_no_place">Choose where your home is: search for it, or enter its coordinates.</string>

  <string name="unusable_title">Settings file cannot be used</string>
  <!-- %1$s the settings file's name, engine.json -->
  <string name="unusable_text">Your settings file, %1$s, cannot be used. Set up again to start over: the file is kept.</string>
  <string name="set_up_again">Set up again</string>
  <string name="set_up_again_question">Set up again?</string>
  <!-- %1$s the settings file's name, engine.json -->
  <string name="set_up_again_explained">%1$s is not deleted: it is kept beside the new settings, under another name. Then set-up starts.</string>
  <string name="set_up_again_moving">Setting the file aside…</string>
  <string name="set_up_again_failed">The file could not be set aside, and is left as it was.</string>

  <string name="newer_title">Update the app</string>
  <string name="newer_text">Your settings were saved by a newer version of the app. Update the app to use them; until then they are left as they are.</string>


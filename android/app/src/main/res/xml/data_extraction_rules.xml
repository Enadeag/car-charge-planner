<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12 and later (#397). Cloud backup takes nothing: every domain is excluded whole, as a section without rules
  would take everything. The transfer to the owner's next phone takes only the files named, the same list as
  backup_rules.xml for Android 10 and 11: the engine's files, the forecast cache and the phone's settings store
  ("Wi-Fi only"). A file no include names stays on the phone: the keychain's file and WorkManager's database in
  noBackupFilesDir, which Android never takes along anyway, the notifications' state store, which belongs to this
  phone, temporary files and copies set aside as damaged. DataExtractionRulesTest holds the two lists to each other
  and to the files the engine and DataStore write.
-->
<data-extraction-rules>
  <cloud-backup>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
    <exclude domain="device_root" path="." />
    <exclude domain="device_file" path="." />
    <exclude domain="device_database" path="." />
    <exclude domain="device_sharedpref" path="." />
  </cloud-backup>
  <device-transfer>
    <include domain="file" path="engine.json" />
    <include domain="file" path="battery.json" />
    <include domain="file" path="away.json" />
    <include domain="file" path="trips.json" />
    <include domain="file" path="trip-notices.json" />
    <include domain="file" path="announced.json" />
    <include domain="file" path="forecasts/" />
    <include domain="file" path="datastore/settings.preferences_pb" />
  </device-transfer>
</data-extraction-rules>

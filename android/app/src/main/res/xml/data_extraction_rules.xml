<?xml version="1.0" encoding="utf-8"?>
<!--
  What may leave the phone, from Android 12 on: everything but the keychain's file, which is useless without its
  Keystore key, and that key never leaves this phone, and the notifications' state store (DataStore's `state`, with the
  temporary file it is written through), which belongs to this phone: whether the notification card was closed or
  Android's question refused, and whether a Problems notification was posted; and WorkManager's database
  (`androidx.work.workdb`, with its `-wal` and `-shm`), whose work the app schedules again when it is next opened.
  Settings, trips, the forecast cache and
  the phone's own settings store (`settings`, the "Wi-Fi only" switch) move to the owner's next phone.
  allowBackup="false" turns cloud backup off already; the rules say the same for it, so that holds should backup ever
  be turned on. The keychain's file lies in noBackupFilesDir (the domain "root" is the app's data folder), with
  the temporary file it is written through and the copy set aside when it could not be read. backup_rules.xml says
  the same for Android 10 and 11.
-->
<data-extraction-rules>
  <cloud-backup>
    <exclude domain="root" path="no_backup/keychain.json" />
    <exclude domain="root" path="no_backup/keychain.json.tmp" />
    <exclude domain="root" path="no_backup/keychain.json.damaged" />
    <exclude domain="file" path="datastore/state.preferences_pb" />
    <exclude domain="file" path="datastore/state.preferences_pb.tmp" />
    <exclude domain="database" path="androidx.work.workdb" />
    <exclude domain="database" path="androidx.work.workdb-wal" />
    <exclude domain="database" path="androidx.work.workdb-shm" />
  </cloud-backup>
  <device-transfer>
    <exclude domain="root" path="no_backup/keychain.json" />
    <exclude domain="root" path="no_backup/keychain.json.tmp" />
    <exclude domain="root" path="no_backup/keychain.json.damaged" />
    <exclude domain="file" path="datastore/state.preferences_pb" />
    <exclude domain="file" path="datastore/state.preferences_pb.tmp" />
    <exclude domain="database" path="androidx.work.workdb" />
    <exclude domain="database" path="androidx.work.workdb-wal" />
    <exclude domain="database" path="androidx.work.workdb-shm" />
  </device-transfer>
</data-extraction-rules>

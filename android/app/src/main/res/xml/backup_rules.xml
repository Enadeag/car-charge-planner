<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 10 and 11 back up nothing while allowBackup="false", device-to-device transfer included; should backup be
  turned on, the keychain's file, the notifications' state store and WorkManager's database still stay, as in
  data_extraction_rules.xml for Android 12 and later. The keychain's file and WorkManager's database lie in
  noBackupFilesDir, which Android never takes along anyway.
-->
<full-backup-content>
  <exclude domain="root" path="no_backup/keychain.json" />
  <exclude domain="root" path="no_backup/keychain.json.tmp" />
  <exclude domain="root" path="no_backup/keychain.json.damaged" />
  <exclude domain="file" path="datastore/state.preferences_pb" />
  <exclude domain="file" path="datastore/state.preferences_pb.tmp" />
  <exclude domain="root" path="no_backup/androidx.work.workdb" />
  <exclude domain="root" path="no_backup/androidx.work.workdb-wal" />
  <exclude domain="root" path="no_backup/androidx.work.workdb-shm" />
</full-backup-content>

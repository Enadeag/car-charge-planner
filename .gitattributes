# Text is stored and checked out with LF on every system, so a Windows checkout compares equal to a Linux one.
* text=auto eol=lf
*.png binary
*.ico binary
*.jar binary
# cmd.exe can misread labels in a batch file with LF line ends
*.cmd text eol=crlf
*.bat text eol=crlf
*.keystore binary
# written by tools/refresh-android-verification.sh, not by hand: GitHub folds its diff in a pull request (#484)
android/gradle/verification-metadata.xml linguist-generated=true

# Text is stored and checked out with LF on every system, so a Windows checkout compares equal to a Linux one.
* text=auto eol=lf
*.png binary
*.ico binary
# cmd.exe can misread labels in a batch file with LF line ends
*.cmd text eol=crlf
# calendars in the iCalendar format end their lines with CRLF, as RFC 5545 asks and the services export them
*.ics text eol=crlf

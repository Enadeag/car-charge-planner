# The house style for every editor. There is no formatter: this only sets what an editor does as you type.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 120

# Java resource bundles are read as UTF-8 (CONTRIBUTING.md, Adding a language)
[*.properties]
charset = utf-8

[*.{xml,svg,yml,yaml,json,sh,ps1}]
indent_size = 2

# kept exactly as fdroid rewritemeta writes it, which puts a space after a key whose value goes on the next line
[tools/fdroid/*.yml]
trim_trailing_whitespace = false

# cmd.exe can misread labels in a batch file with LF line ends (.gitattributes)
[*.{cmd,bat}]
end_of_line = crlf

# Markdown is not wrapped by hand: a paragraph or a list item is one line
[*.md]
max_line_length = off

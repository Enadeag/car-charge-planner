# The house style for every editor. There is no formatter: this only sets what an editor does as you type.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 120

# Java resource bundles are read as UTF-8 (CONTRIBUTING.md, Adding a language)
[*.properties]
charset = utf-8

[*.{xml,svg,yml,yaml,json,sh,ps1}]
indent_size = 2

# cmd.exe can misread labels in a batch file with LF line ends (.gitattributes)
[*.cmd]
end_of_line = crlf

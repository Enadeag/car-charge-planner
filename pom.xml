<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.github.enadeag</groupId>
  <artifactId>car-charge-planner</artifactId>
  <version>0.4.0-SNAPSHOT</version>
  <name>Car charge planner</name>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>25</maven.compiler.release>
    <main.class>io.github.enadeag.carchargeplanner.Main</main.class>
    <!-- surefire's test class order; see the surefire plugin below -->
    <surefire.runOrder>alphabetical</surefire.runOrder>
    <!-- left out of every build: the tests that reach the network, which the live profile runs, and the one that
         writes the README's pictures, which the screenshots profile runs -->
    <test.excludedGroups>live,screenshots</test.excludedGroups>
    <!-- the coverage profile sets it to JaCoCo's agent -->
    <argLine></argLine>
    <app.args></app.args>

    <javafx.version>27</javafx.version>
    <!-- the classifier of JavaFX's per-system jars; the profiles below set it for Windows and macOS -->
    <javafx.platform>linux</javafx.platform>
    <atlantafx.version>3.0.0</atlantafx.version>
    <dbus-java.version>5.2.2</dbus-java.version>
    <jackson.version>3.2.3</jackson.version>
    <slf4j.version>2.0.20</slf4j.version>

    <junit.version>5.14.4</junit.version>
    <assertj.version>3.27.7</assertj.version>
    <archunit.version>1.5.1</archunit.version>
    <jacoco.version>0.8.15</jacoco.version>
    <pitest.version>1.30.0</pitest.version>
    <pitest-junit5.version>1.2.3</pitest-junit5.version>
    <!-- the JVMs PIT runs the tests in at once, each with its own heap (pit.heap) -->
    <pit.threads>2</pit.threads>
    <pit.heap>512m</pit.heap>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- dbus-java brings an older 2.0.x; one version for the API and its binding -->
      <dependency>
        <groupId>org.slf4j</groupId>
        <artifactId>slf4j-api</artifactId>
        <version>${slf4j.version}</version>
      </dependency>
      <dependency>
        <groupId>tools.jackson</groupId>
        <artifactId>jackson-bom</artifactId>
        <version>${jackson.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- JavaFX's jars with the classes are the ones with the system's classifier; the unclassified ones are empty -->
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-base</artifactId>
      <version>${javafx.version}</version>
      <classifier>${javafx.platform}</classifier>
    </dependency>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-graphics</artifactId>
      <version>${javafx.version}</version>
      <classifier>${javafx.platform}</classifier>
    </dependency>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-controls</artifactId>
      <version>${javafx.version}</version>
      <classifier>${javafx.platform}</classifier>
    </dependency>
    <dependency>
      <groupId>io.github.mkpaz</groupId>
      <artifactId>atlantafx-base</artifactId>
      <version>${atlantafx.version}</version>
    </dependency>
    <dependency>
      <groupId>com.github.hypfvieh</groupId>
      <artifactId>dbus-java-core</artifactId>
      <version>${dbus-java.version}</version>
    </dependency>
    <dependency>
      <groupId>com.github.hypfvieh</groupId>
      <artifactId>dbus-java-transport-native-unixsocket</artifactId>
      <version>${dbus-java.version}</version>
    </dependency>
    <dependency>
      <groupId>tools.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <dependency>
      <groupId>tools.jackson.core</groupId>
      <artifactId>jackson-core</artifactId>
    </dependency>
    <!-- dbus-java logs through SLF4J; this sends it to java.util.logging, where the app's own messages go -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-jdk14</artifactId>
      <version>${slf4j.version}</version>
      <scope>runtime</scope>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-api</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-params</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-engine</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <version>${assertj.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit</artifactId>
      <version>${archunit.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5-api</artifactId>
      <version>${archunit.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5-engine</artifactId>
      <version>${archunit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>car-charge-planner</finalName>
    <!-- only the version file is filtered: the text bundles hold {0}-style places of their own -->
    <resources>
      <resource>
        <directory>src/main/resources</directory>
      </resource>
      <resource>
        <directory>src/main/resources-filtered</directory>
        <filtering>true</filtering>
      </resource>
      <!-- the app icon's drawing, which the menu entry installs as the scalable icon -->
      <resource>
        <directory>src/packaging/icons</directory>
        <includes>
          <include>car-charge-planner.svg</include>
        </includes>
        <targetPath>io/github/enadeag/carchargeplanner/desktop/system/icons</targetPath>
      </resource>
    </resources>
    <plugins>
      <!-- jpackage makes the Windows launcher read-only; without force, clean cannot remove it -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-clean-plugin</artifactId>
        <version>3.5.0</version>
        <configuration>
          <force>true</force>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.16.0</version>
        <configuration>
          <compilerArgs>
            <arg>-Xlint:all,-serial</arg>
          </compilerArgs>
        </configuration>
        <executions>
          <!-- main code only: any lint or doclint finding fails the build, so each public, protected and package-private
               element needs full Javadoc (CONTRIBUTING.md); the tests get the lint without doclint, below. "restricted" is
               off because the Credential Manager is reached on purpose through the foreign function API. -->
          <execution>
            <id>default-compile</id>
            <configuration>
              <compilerArgs>
                <arg>-Xlint:all,-serial,-restricted</arg>
                <arg>-Xdoclint:all/package</arg>
                <arg>-Werror</arg>
              </compilerArgs>
            </configuration>
          </execution>
          <!-- the tests fail on any lint finding too, without the doclint of the main code -->
          <execution>
            <id>default-testCompile</id>
            <configuration>
              <compilerArgs>
                <arg>-Xlint:all,-serial</arg>
                <arg>-Werror</arg>
              </compilerArgs>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.6.0</version>
        <configuration>
          <!-- the Credential Manager is reached through Java's foreign function API -->
          <argLine>@{argLine} --enable-native-access=ALL-UNNAMED</argLine>
          <!-- the same order on every system and every run; -Dsurefire.runOrder=random shows what depends on it -->
          <runOrder>${surefire.runOrder}</runOrder>
          <excludedGroups>${test.excludedGroups}</excludedGroups>
          <systemPropertyVariables>
            <!-- no test may put an AWT window or tray icon on the developer's desktop -->
            <java.awt.headless>true</java.awt.headless>
            <!-- nor a JavaFX one: whichever test touches JavaFX first, it starts headless -->
            <glass.platform>Headless</glass.platform>
            <prism.order>sw</prism.order>
            <java.util.logging.config.file>${project.basedir}/src/test/resources/logging.properties</java.util.logging.config.file>
          </systemPropertyVariables>
          <!-- and the test JVM cannot reach the developer's display at all -->
          <excludedEnvironmentVariables>
            <param>DISPLAY</param>
            <param>WAYLAND_DISPLAY</param>
          </excludedEnvironmentVariables>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.5.1</version>
        <configuration>
          <archive>
            <manifest>
              <mainClass>${main.class}</mainClass>
            </manifest>
          </archive>
        </configuration>
      </plugin>
      <!-- the packaging scripts take the runtime libraries from target/lib -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>3.11.0</version>
        <executions>
          <!-- fails on a library the code uses but does not declare, or declares but does not use -->
          <execution>
            <id>analyze-dependencies</id>
            <phase>verify</phase>
            <goals>
              <goal>analyze-only</goal>
            </goals>
            <configuration>
              <failOnWarning>true</failOnWarning>
              <ignoredUnusedDeclaredDependencies>
                <!-- found at run time, never named in the code: the SLF4J binding, the D-Bus socket transport
                     and the JUnit and ArchUnit test engines -->
                <ignoredUnusedDeclaredDependency>org.slf4j:slf4j-jdk14</ignoredUnusedDeclaredDependency>
                <ignoredUnusedDeclaredDependency>com.github.hypfvieh:dbus-java-transport-native-unixsocket</ignoredUnusedDeclaredDependency>
                <ignoredUnusedDeclaredDependency>org.junit.jupiter:junit-jupiter-engine</ignoredUnusedDeclaredDependency>
                <ignoredUnusedDeclaredDependency>com.tngtech.archunit:archunit-junit5-engine</ignoredUnusedDeclaredDependency>
              </ignoredUnusedDeclaredDependencies>
            </configuration>
          </execution>
          <!-- the list of runtime libraries LegalFilesTest checks against src/packaging/legal -->
          <execution>
            <id>list-runtime-libraries</id>
            <phase>generate-test-resources</phase>
            <goals>
              <goal>list</goal>
            </goals>
            <configuration>
              <includeScope>runtime</includeScope>
              <outputFile>${project.build.directory}/runtime-libraries.txt</outputFile>
            </configuration>
          </execution>
          <execution>
            <id>copy-runtime-libraries</id>
            <phase>package</phase>
            <goals>
              <goal>copy-dependencies</goal>
            </goals>
            <configuration>
              <includeScope>runtime</includeScope>
              <outputDirectory>${project.build.directory}/lib</outputDirectory>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- target/car-charge-planner.cdx.json, an SBOM of the libraries the app brings at run time, which the packaging
           scripts complete with the runtime (tools/SbomRuntime.java). With project.build.outputTimestamp, which the
           packaging scripts set to the commit's time, it is reproducible: no timestamp, a serial number from its
           content. -->
      <plugin>
        <groupId>org.cyclonedx</groupId>
        <artifactId>cyclonedx-maven-plugin</artifactId>
        <version>2.9.3</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>makeBom</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <projectType>application</projectType>
          <schemaVersion>1.6</schemaVersion>
          <outputFormat>json</outputFormat>
          <outputName>car-charge-planner.cdx</outputName>
          <includeTestScope>false</includeTestScope>
          <includeProvidedScope>false</includeProvidedScope>
          <includeSystemScope>false</includeSystemScope>
        </configuration>
      </plugin>
      <!-- ./mvnw compile exec:exec runs the app from the build; -Dapp.args="..." passes it arguments -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.6.4</version>
        <configuration>
          <!-- the JDK that runs Maven, not whichever java comes first on the PATH -->
          <executable>${java.home}/bin/java</executable>
          <commandlineArgs>--enable-native-access=ALL-UNNAMED -classpath %classpath ${main.class} ${app.args}</commandlineArgs>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>javafx-windows</id>
      <activation>
        <os>
          <family>windows</family>
        </os>
      </activation>
      <properties>
        <javafx.platform>win</javafx.platform>
      </properties>
    </profile>
    <profile>
      <id>javafx-mac</id>
      <activation>
        <os>
          <family>mac</family>
        </os>
      </activation>
      <properties>
        <javafx.platform>mac</javafx.platform>
      </properties>
    </profile>
    <!-- ./mvnw test -Plive runs only the tests tagged "live", which ask the real forecast services (CONTRIBUTING.md,
         What is tested where) -->
    <profile>
      <id>live</id>
      <properties>
        <test.excludedGroups></test.excludedGroups>
        <groups>live</groups>
      </properties>
    </profile>
    <!-- ./mvnw test -Pscreenshots makes the README's pictures in docs/screenshots/java again, offscreen on JavaFX's
         headless platform, and writes only those whose pixels changed (CONTRIBUTING.md, Pictures for the README) -->
    <profile>
      <id>screenshots</id>
      <properties>
        <test.excludedGroups></test.excludedGroups>
        <groups>screenshots</groups>
      </properties>
    </profile>
    <!-- ./mvnw verify -Pcoverage: JaCoCo's report in target/site/jacoco/, and the build fails when a part's line or
         branch coverage drops below its floor (CONTRIBUTING.md, What is tested where). Linux only: the platform.linux
         tests need dbus-daemon and GNOME Keyring, and Windows runs none of them. Not checked: the root package, the
         composition root, which DesktopAppSmokeTest tests in a JVM of its own, and platform.windows. Each floor is a
         point or two below what was measured when it was set: raise it when the tests grow, never lower it to let a
         change through. -->
    <profile>
      <id>coverage</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.jacoco</groupId>
            <artifactId>jacoco-maven-plugin</artifactId>
            <version>${jacoco.version}</version>
            <executions>
              <execution>
                <id>coverage-agent</id>
                <goals>
                  <goal>prepare-agent</goal>
                </goals>
              </execution>
              <execution>
                <id>coverage-report</id>
                <goals>
                  <goal>report</goal>
                </goals>
              </execution>
              <execution>
                <id>coverage-engine</id>
                <goals>
                  <goal>check</goal>
                </goals>
                <configuration>
                  <includes>
                    <include>io/github/enadeag/carchargeplanner/engine/**</include>
                  </includes>
                  <rules>
                    <rule>
                      <element>BUNDLE</element>
                      <limits>
                        <limit>
                          <counter>LINE</counter>
                          <value>COVEREDRATIO</value>
                          <minimum>0.96</minimum>
                        </limit>
                        <limit>
                          <counter>BRANCH</counter>
                          <value>COVEREDRATIO</value>
                          <minimum>0.90</minimum>
                        </limit>
                      </limits>
                    </rule>
                  </rules>
                </configuration>
              </execution>
              <execution>
                <id>coverage-desktop</id>
                <goals>
                  <goal>check</goal>
                </goals>
                <configuration>
                  <includes>
                    <include>io/github/enadeag/carchargeplanner/desktop/**</include>
                  </includes>
                  <rules>
                    <rule>
                      <element>BUNDLE</element>
                      <limits>
                        <limit>
                          <counter>LINE</counter>
                          <value>COVEREDRATIO</value>
                          <minimum>0.95</minimum>
                        </limit>
                        <limit>
                          <counter>BRANCH</counter>
                          <value>COVEREDRATIO</value>
                          <minimum>0.82</minimum>
                        </limit>
                      </limits>
                    </rule>
                  </rules>
                </configuration>
              </execution>
              <execution>
                <id>coverage-instance</id>
                <goals>
                  <goal>check</goal>
                </goals>
                <configuration>
                  <includes>
                    <include>io/github/enadeag/carchargeplanner/instance/**</include>
                  </includes>
                  <rules>
                    <rule>
                      <element>BUNDLE</element>
                      <limits>
                        <limit>
                          <counter>LINE</counter>
                          <value>COVEREDRATIO</value>
                          <minimum>0.88</minimum>
                        </limit>
                        <limit>
                          <counter>BRANCH</counter>
                          <value>COVEREDRATIO</value>
                          <minimum>0.74</minimum>
                        </limit>
                      </limits>
                    </rule>
                  </rules>
                </configuration>
              </execution>
              <execution>
                <id>coverage-platform-linux</id>
                <goals>
                  <goal>check</goal>
                </goals>
                <configuration>
                  <includes>
                    <include>io/github/enadeag/carchargeplanner/platform/linux/**</include>
                  </includes>
                  <rules>
                    <rule>
                      <element>BUNDLE</element>
                      <limits>
                        <limit>
                          <counter>LINE</counter>
                          <value>COVEREDRATIO</value>
                          <minimum>0.86</minimum>
                        </limit>
                        <limit>
                          <counter>BRANCH</counter>
                          <value>COVEREDRATIO</value>
                          <minimum>0.75</minimum>
                        </limit>
                      </limits>
                    </rule>
                  </rules>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <!-- Mutation testing with PIT (CONTRIBUTING.md, What is tested where), for the engine and for the desktop's logic
         that needs no JavaFX:
           ./mvnw -Ppit test-compile pitest:mutationCoverage@engine    report in target/pit-reports/engine/
           ./mvnw -Ppit test-compile pitest:mutationCoverage@desktop   report in target/pit-reports/desktop/
         It fails when fewer mutants than the threshold are killed. -Dpit.threads=4 runs more test JVMs at once; each
         takes a heap of pit.heap. -->
    <profile>
      <id>pit</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.pitest</groupId>
            <artifactId>pitest-maven</artifactId>
            <version>${pitest.version}</version>
            <dependencies>
              <dependency>
                <groupId>org.pitest</groupId>
                <artifactId>pitest-junit5-plugin</artifactId>
                <version>${pitest-junit5.version}</version>
              </dependency>
            </dependencies>
            <configuration>
              <threads>${pit.threads}</threads>
              <timestampedReports>false</timestampedReports>
              <outputFormats>
                <param>HTML</param>
                <param>XML</param>
              </outputFormats>
              <!-- PIT runs the tests in JVMs of its own, without surefire's settings: the same headless set-up here -->
              <jvmArgs>
                <value>-Xmx${pit.heap}</value>
                <value>--enable-native-access=ALL-UNNAMED</value>
                <value>-Djava.awt.headless=true</value>
                <value>-Dglass.platform=Headless</value>
                <value>-Dprism.order=sw</value>
                <value>-Djava.util.logging.config.file=${project.basedir}/src/test/resources/logging.properties</value>
              </jvmArgs>
              <excludedGroups>
                <param>live</param>
                <param>fx</param>
              </excludedGroups>
            </configuration>
            <executions>
              <execution>
                <id>engine</id>
                <configuration>
                  <targetClasses>
                    <param>io.github.enadeag.carchargeplanner.engine.*</param>
                  </targetClasses>
                  <targetTests>
                    <param>io.github.enadeag.carchargeplanner.engine.*</param>
                  </targetTests>
                  <reportsDirectory>${project.build.directory}/pit-reports/engine</reportsDirectory>
                  <!-- a few points below the share of mutants killed when it was set (97 %) -->
                  <mutationThreshold>94</mutationThreshold>
                </configuration>
              </execution>
              <execution>
                <id>desktop</id>
                <configuration>
                  <!-- the classes that the tests without JavaFX (no @FxTest) cover: the mappers to the dashboard's
                       models, chart and popup geometry, the app settings, the logic of the Settings and set-up forms,
                       the tray icon's drawing and the texts -->
                  <targetClasses>
                    <param>io.github.enadeag.carchargeplanner.desktop.app.AppSettings*</param>
                    <param>io.github.enadeag.carchargeplanner.desktop.app.Background*</param>
                    <param>io.github.enadeag.carchargeplanner.desktop.app.DisplayMode*</param>
                    <param>io.github.enadeag.carchargeplanner.desktop.app.Units*</param>
                    <param>io.github.enadeag.carchargeplanner.desktop.dashboard.AwayMapper*</param>
                    <param>io.github.enadeag.carchargeplanner.desktop.dashboard.BatteryModel*</param>
                    <param>io.github.enadeag.carchargeplanner.desktop.dashboard.ChartMapper*</param>
                    <param>io.github.enadeag.carchargeplanner.desktop.dashboard.CurvePoints*</param>
                    <param>io.github.enadeag.carchargeplanner.desktop.dashboard.DayMapper*</param>
                    <param>io.github.enadeag.carchargeplanner.desktop.dashboard.GridAdviceMapper*</param>
                    <param>io.github.enadeag.carchargeplanner.desktop.dashboard.OutlookMapper*</param>
                    <param>io.github.enadeag.carchargeplanner.desktop.dashboard.PlotArea*</param>
                    <param>io.github.enadeag.carchargeplanner.desktop.dashboard.PopupPlacement*</param>
                    <param>io.github.enadeag.carchargeplanner.desktop.dashboard.SolarCurveModel*</param>
                    <param>io.github.enadeag.carchargeplanner.desktop.dashboard.TrayStatusMapper*</param>
                    <param>io.github.enadeag.carchargeplanner.desktop.dashboard.TrayTexts*</param>
                    <param>io.github.enadeag.carchargeplanner.desktop.settings.SetUpOffer*</param>
                    <param>io.github.enadeag.carchargeplanner.desktop.settings.WindowSize*</param>
                    <param>io.github.enadeag.carchargeplanner.desktop.settings.form.*</param>
                    <param>io.github.enadeag.carchargeplanner.desktop.system.StatusIcon*</param>
                    <param>io.github.enadeag.carchargeplanner.desktop.text.*</param>
                  </targetClasses>
                  <targetTests>
                    <param>io.github.enadeag.carchargeplanner.desktop.*</param>
                  </targetTests>
                  <reportsDirectory>${project.build.directory}/pit-reports/desktop</reportsDirectory>
                  <!-- a few points below the share of mutants killed when it was set (87 %) -->
                  <mutationThreshold>84</mutationThreshold>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>

</project>

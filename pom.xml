<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- The parent of the two modules (ADR 0010, issue #263): the engine, which Android will share; the desktop app,
       which builds car-charge-planner.jar. The one version of the app
       is revision below; every module names it as ${revision} in its <parent> and inherits it, so a release sets it
       here alone (CONTRIBUTING.md, Releasing). -->
  <groupId>nl.enadeag</groupId>
  <artifactId>car-charge-planner-parent</artifactId>
  <version>${revision}</version>
  <packaging>pom</packaging>
  <name>Car charge planner</name>

  <modules>
    <module>engine</module>
    <module>desktop</module>
  </modules>

  <properties>
    <revision>0.5.1-SNAPSHOT</revision>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>25</maven.compiler.release>
    <!-- surefire's test class order; see the surefire plugin below -->
    <surefire.runOrder>alphabetical</surefire.runOrder>
    <!-- left out of every build: the tests that reach the network, which the live profile runs, and the one that
         writes the documentation's pictures, which the screenshots profile runs -->
    <test.excludedGroups>live,screenshots</test.excludedGroups>
    <!-- the coverage profile sets it to JaCoCo's agent -->
    <argLine></argLine>

    <javafx.version>27</javafx.version>
    <!-- the classifier of JavaFX's per-system jars; the profiles below set it for Windows and macOS -->
    <javafx.platform>linux</javafx.platform>
    <atlantafx.version>3.0.0</atlantafx.version>
    <dbus-java.version>5.2.2</dbus-java.version>
    <jackson.version>3.2.3</jackson.version>
    <slf4j.version>2.0.20</slf4j.version>

    <junit.version>6.1.3</junit.version>
    <assertj.version>3.27.7</assertj.version>
    <archunit.version>1.5.1</archunit.version>
    <jacoco.version>0.8.15</jacoco.version>
    <pitest.version>1.30.1</pitest.version>
    <pitest-junit5.version>1.2.3</pitest-junit5.version>
    <!-- the JVMs PIT runs the tests in at once, each with its own heap (pit.heap) -->
    <pit.threads>2</pit.threads>
    <pit.heap>512m</pit.heap>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>nl.enadeag</groupId>
        <artifactId>car-charge-planner-engine</artifactId>
        <version>${project.version}</version>
      </dependency>
      <!-- the engine's test classes, with the helpers the desktop's tests share (LogCapture, FakeProvider, ...) -->
      <dependency>
        <groupId>nl.enadeag</groupId>
        <artifactId>car-charge-planner-engine</artifactId>
        <version>${project.version}</version>
        <type>test-jar</type>
      </dependency>
      <!-- JavaFX's jars with the classes are the ones with the system's classifier; the unclassified ones are empty -->
      <dependency>
        <groupId>org.openjfx</groupId>
        <artifactId>javafx-base</artifactId>
        <version>${javafx.version}</version>
        <classifier>${javafx.platform}</classifier>
      </dependency>
      <dependency>
        <groupId>org.openjfx</groupId>
        <artifactId>javafx-graphics</artifactId>
        <version>${javafx.version}</version>
        <classifier>${javafx.platform}</classifier>
      </dependency>
      <dependency>
        <groupId>org.openjfx</groupId>
        <artifactId>javafx-controls</artifactId>
        <version>${javafx.version}</version>
        <classifier>${javafx.platform}</classifier>
      </dependency>
      <dependency>
        <groupId>io.github.mkpaz</groupId>
        <artifactId>atlantafx-base</artifactId>
        <version>${atlantafx.version}</version>
      </dependency>
      <dependency>
        <groupId>com.github.hypfvieh</groupId>
        <artifactId>dbus-java-core</artifactId>
        <version>${dbus-java.version}</version>
      </dependency>
      <dependency>
        <groupId>com.github.hypfvieh</groupId>
        <artifactId>dbus-java-transport-native-unixsocket</artifactId>
        <version>${dbus-java.version}</version>
      </dependency>
      <!-- dbus-java brings an older 2.0.x; one version for the API and its binding -->
      <dependency>
        <groupId>org.slf4j</groupId>
        <artifactId>slf4j-api</artifactId>
        <version>${slf4j.version}</version>
      </dependency>
      <dependency>
        <groupId>org.slf4j</groupId>
        <artifactId>slf4j-jdk14</artifactId>
        <version>${slf4j.version}</version>
      </dependency>
      <dependency>
        <groupId>tools.jackson</groupId>
        <artifactId>jackson-bom</artifactId>
        <version>${jackson.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.assertj</groupId>
        <artifactId>assertj-core</artifactId>
        <version>${assertj.version}</version>
      </dependency>
      <dependency>
        <groupId>com.tngtech.archunit</groupId>
        <artifactId>archunit</artifactId>
        <version>${archunit.version}</version>
      </dependency>
      <dependency>
        <groupId>com.tngtech.archunit</groupId>
        <artifactId>archunit-junit5-api</artifactId>
        <version>${archunit.version}</version>
      </dependency>
      <dependency>
        <groupId>com.tngtech.archunit</groupId>
        <artifactId>archunit-junit5-engine</artifactId>
        <version>${archunit.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.16.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.6.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <version>3.5.1</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-dependency-plugin</artifactId>
          <version>3.11.0</version>
        </plugin>
        <plugin>
          <groupId>org.cyclonedx</groupId>
          <artifactId>cyclonedx-maven-plugin</artifactId>
          <version>2.9.3</version>
        </plugin>
        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>exec-maven-plugin</artifactId>
          <version>3.6.4</version>
        </plugin>
        <plugin>
          <groupId>org.jacoco</groupId>
          <artifactId>jacoco-maven-plugin</artifactId>
          <version>${jacoco.version}</version>
        </plugin>
        <plugin>
          <groupId>org.pitest</groupId>
          <artifactId>pitest-maven</artifactId>
          <version>${pitest.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <!-- jpackage makes the Windows launcher read-only; without force, clean cannot remove it -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-clean-plugin</artifactId>
        <version>3.5.0</version>
        <configuration>
          <force>true</force>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <compilerArgs>
            <arg>-Xlint:all,-serial</arg>
          </compilerArgs>
        </configuration>
        <executions>
          <!-- main code only: any lint or doclint finding fails the build, so each public, protected and package-private
               element needs full Javadoc (CONTRIBUTING.md); the tests get the lint without doclint, below. "restricted" is
               off because the Credential Manager is reached on purpose through the foreign function API. -->
          <execution>
            <id>default-compile</id>
            <configuration>
              <compilerArgs>
                <arg>-Xlint:all,-serial,-restricted</arg>
                <arg>-Xdoclint:all/package</arg>
                <arg>-Werror</arg>
              </compilerArgs>
            </configuration>
          </execution>
          <!-- the tests fail on any lint finding too, without the doclint of the main code -->
          <execution>
            <id>default-testCompile</id>
            <configuration>
              <compilerArgs>
                <arg>-Xlint:all,-serial</arg>
                <arg>-Werror</arg>
              </compilerArgs>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <!-- every module's tests run in the repository's root, where they find docs/, tools/ and src/packaging/;
               an IDE needs the same working directory (CONTRIBUTING.md, Set up) -->
          <workingDirectory>${maven.multiModuleProjectDirectory}</workingDirectory>
          <!-- the same order on every system and every run; -Dsurefire.runOrder=random shows what depends on it -->
          <runOrder>${surefire.runOrder}</runOrder>
          <excludedGroups>${test.excludedGroups}</excludedGroups>
          <systemPropertyVariables>
            <!-- no test may put an AWT window or tray icon on the developer's desktop -->
            <java.awt.headless>true</java.awt.headless>
            <java.util.logging.config.file>${project.basedir}/src/test/resources/logging.properties</java.util.logging.config.file>
          </systemPropertyVariables>
          <!-- and the test JVM cannot reach the developer's display at all -->
          <excludedEnvironmentVariables>
            <param>DISPLAY</param>
            <param>WAYLAND_DISPLAY</param>
          </excludedEnvironmentVariables>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <!-- fails on a library the code uses but does not declare, or declares but does not use -->
          <execution>
            <id>analyze-dependencies</id>
            <phase>verify</phase>
            <goals>
              <goal>analyze-only</goal>
            </goals>
            <configuration>
              <failOnWarning>true</failOnWarning>
              <ignoredUnusedDeclaredDependencies>
                <!-- found at run time, never named in the code: the SLF4J binding, the D-Bus socket transport
                     and the JUnit and ArchUnit test engines -->
                <ignoredUnusedDeclaredDependency>org.slf4j:slf4j-jdk14</ignoredUnusedDeclaredDependency>
                <ignoredUnusedDeclaredDependency>com.github.hypfvieh:dbus-java-transport-native-unixsocket</ignoredUnusedDeclaredDependency>
                <ignoredUnusedDeclaredDependency>org.junit.jupiter:junit-jupiter-engine</ignoredUnusedDeclaredDependency>
                <ignoredUnusedDeclaredDependency>com.tngtech.archunit:archunit-junit5-engine</ignoredUnusedDeclaredDependency>
              </ignoredUnusedDeclaredDependencies>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- only the desktop module runs the app; the others skip exec:exec when it is run with -am -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <configuration>
          <skip>true</skip>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>javafx-windows</id>
      <activation>
        <os>
          <family>windows</family>
        </os>
      </activation>
      <properties>
        <javafx.platform>win</javafx.platform>
      </properties>
    </profile>
    <profile>
      <id>javafx-mac</id>
      <activation>
        <os>
          <family>mac</family>
        </os>
      </activation>
      <properties>
        <javafx.platform>mac</javafx.platform>
      </properties>
    </profile>
    <!-- ./mvnw test -Plive runs only the tests tagged "live", which ask the real forecast services (CONTRIBUTING.md,
         What is tested where) -->
    <profile>
      <id>live</id>
      <properties>
        <test.excludedGroups></test.excludedGroups>
        <groups>live</groups>
      </properties>
    </profile>
    <!-- ./mvnw test -Pscreenshots makes the documentation's pictures in docs/screenshots/java again, offscreen on
         JavaFX's headless platform, and writes only those whose pixels changed (CONTRIBUTING.md, Pictures in the
         documentation) -->
    <profile>
      <id>screenshots</id>
      <properties>
        <test.excludedGroups></test.excludedGroups>
        <groups>screenshots</groups>
      </properties>
    </profile>
    <!-- ./mvnw verify -Pcoverage: JaCoCo's report in each module's target/site/jacoco/, and the build fails when a
         part's line or branch coverage drops below its floor (CONTRIBUTING.md, What is tested where). Each module
         checks its own classes from its own tests; the floors are in the modules' coverage profiles. -->
    <profile>
      <id>coverage</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.jacoco</groupId>
            <artifactId>jacoco-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>coverage-agent</id>
                <goals>
                  <goal>prepare-agent</goal>
                </goals>
              </execution>
              <execution>
                <id>coverage-report</id>
                <goals>
                  <goal>report</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <!-- Mutation testing with PIT (CONTRIBUTING.md, What is tested where), for the engine and for the desktop's logic
         that needs no JavaFX:
           ./mvnw -Ppit test-compile pitest:mutationCoverage@engine    report in engine/target/pit-reports/engine/
           ./mvnw -Ppit test-compile pitest:mutationCoverage@desktop   report in desktop/target/pit-reports/desktop/
         Each execution is in its own module, and the other module skips it. It fails when fewer mutants than the
         threshold are killed. -Dpit.threads=4 runs more test JVMs at once; each takes a heap of pit.heap. -->
    <profile>
      <id>pit</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.pitest</groupId>
            <artifactId>pitest-maven</artifactId>
            <dependencies>
              <dependency>
                <groupId>org.pitest</groupId>
                <artifactId>pitest-junit5-plugin</artifactId>
                <version>${pitest-junit5.version}</version>
              </dependency>
            </dependencies>
            <configuration>
              <skip>true</skip>
              <threads>${pit.threads}</threads>
              <timestampedReports>false</timestampedReports>
              <outputFormats>
                <param>HTML</param>
                <param>XML</param>
              </outputFormats>
              <!-- PIT runs the tests in JVMs of its own, without surefire's settings: the same headless set-up here, and
                   the repository's root as the working directory, which PIT sets to the module's own folder -->
              <jvmArgs>
                <value>-Xmx${pit.heap}</value>
                <value>-Duser.dir=${maven.multiModuleProjectDirectory}</value>
                <value>-Djava.awt.headless=true</value>
                <value>-Djava.util.logging.config.file=${project.basedir}/src/test/resources/logging.properties</value>
              </jvmArgs>
              <excludedGroups>
                <param>live</param>
                <param>fx</param>
              </excludedGroups>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>

</project>

<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>nl.enadeag</groupId>
    <artifactId>car-charge-planner-parent</artifactId>
    <version>${revision}</version>
  </parent>

  <!-- The desktop app: the dashboard, Settings, the platforms, the single-instance guard and the composition root,
       built into car-charge-planner.jar with its runtime libraries in target/lib, which the packaging scripts take. -->
  <artifactId>car-charge-planner-desktop</artifactId>
  <name>Car charge planner desktop</name>

  <properties>
    <main.class>nl.enadeag.carchargeplanner.Main</main.class>
    <app.args></app.args>
  </properties>

  <dependencies>
    <dependency>
      <groupId>nl.enadeag</groupId>
      <artifactId>car-charge-planner-engine</artifactId>
    </dependency>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-base</artifactId>
      <classifier>${javafx.platform}</classifier>
    </dependency>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-graphics</artifactId>
      <classifier>${javafx.platform}</classifier>
    </dependency>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-controls</artifactId>
      <classifier>${javafx.platform}</classifier>
    </dependency>
    <dependency>
      <groupId>io.github.mkpaz</groupId>
      <artifactId>atlantafx-base</artifactId>
    </dependency>
    <dependency>
      <groupId>com.github.hypfvieh</groupId>
      <artifactId>dbus-java-core</artifactId>
    </dependency>
    <dependency>
      <groupId>com.github.hypfvieh</groupId>
      <artifactId>dbus-java-transport-native-unixsocket</artifactId>
    </dependency>
    <dependency>
      <groupId>tools.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <!-- dbus-java logs through SLF4J; this sends it to java.util.logging, where the app's own messages go -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-jdk14</artifactId>
      <scope>runtime</scope>
    </dependency>

    <dependency>
      <groupId>nl.enadeag</groupId>
      <artifactId>car-charge-planner-engine</artifactId>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-api</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-params</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-engine</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5-api</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5-engine</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>car-charge-planner</finalName>
    <!-- only the version file is filtered: the text bundles hold {0}-style places of their own -->
    <resources>
      <resource>
        <directory>src/main/resources</directory>
      </resource>
      <resource>
        <directory>src/main/resources-filtered</directory>
        <filtering>true</filtering>
      </resource>
      <!-- the app icon's drawing, which the menu entry installs as the scalable icon -->
      <resource>
        <directory>${project.basedir}/../src/packaging/icons</directory>
        <includes>
          <include>car-charge-planner.svg</include>
        </includes>
        <targetPath>nl/enadeag/carchargeplanner/desktop/system/icons</targetPath>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <!-- the Credential Manager is reached through Java's foreign function API -->
          <argLine>@{argLine} --enable-native-access=ALL-UNNAMED</argLine>
          <systemPropertyVariables>
            <!-- nor a JavaFX window: whichever test touches JavaFX first, it starts headless -->
            <glass.platform>Headless</glass.platform>
            <prism.order>sw</prism.order>
          </systemPropertyVariables>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <archive>
            <manifest>
              <mainClass>${main.class}</mainClass>
            </manifest>
          </archive>
        </configuration>
      </plugin>
      <!-- the packaging scripts take the runtime libraries from desktop/target/lib -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <!-- the list of runtime libraries PackagingTest checks against src/packaging/legal -->
          <execution>
            <id>list-runtime-libraries</id>
            <phase>generate-test-resources</phase>
            <goals>
              <goal>list</goal>
            </goals>
            <configuration>
              <includeScope>runtime</includeScope>
              <outputFile>${project.build.directory}/runtime-libraries.txt</outputFile>
            </configuration>
          </execution>
          <execution>
            <id>copy-runtime-libraries</id>
            <phase>package</phase>
            <goals>
              <goal>copy-dependencies</goal>
            </goals>
            <configuration>
              <includeScope>runtime</includeScope>
              <outputDirectory>${project.build.directory}/lib</outputDirectory>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- desktop/target/car-charge-planner.cdx.json, an SBOM of the libraries the app brings at run time, the engine
           among them, which the packaging scripts complete with the runtime (tools/SbomRuntime.java). With
           project.build.outputTimestamp, which the packaging scripts set to the commit's time, it is reproducible: no
           timestamp, a serial number from its content. -->
      <plugin>
        <groupId>org.cyclonedx</groupId>
        <artifactId>cyclonedx-maven-plugin</artifactId>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>makeBom</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <projectType>application</projectType>
          <schemaVersion>1.6</schemaVersion>
          <outputFormat>json</outputFormat>
          <outputName>car-charge-planner.cdx</outputName>
          <includeTestScope>false</includeTestScope>
          <includeProvidedScope>false</includeProvidedScope>
          <includeSystemScope>false</includeSystemScope>
        </configuration>
      </plugin>
      <!-- ./mvnw -pl car-charge-planner-desktop -am compile exec:exec runs the app from the build; -Dapp.args="..."
           passes it arguments -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <configuration>
          <skip>false</skip>
          <!-- the JDK that runs Maven, not whichever java comes first on the PATH -->
          <executable>${java.home}/bin/java</executable>
          <!-- the repository's root, as for the tests, so a config file in docs/ can be passed by its relative path -->
          <workingDirectory>${maven.multiModuleProjectDirectory}</workingDirectory>
          <commandlineArgs>--enable-native-access=ALL-UNNAMED -classpath %classpath ${main.class} ${app.args}</commandlineArgs>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- The desktop's floors, from the desktop's own tests. Linux only: the platform.linux tests need dbus-daemon and
         GNOME Keyring, and Windows runs none of them. Not checked: the classes that wire the app (Main,
         start.DesktopApp, host.Host and the *Parts classes in platforms), which DesktopAppSmokeTest tests in a JVM of
         its own, and platform.windows. Each floor is a point or two below what was measured when it was set: raise it
         when the tests grow, never lower it to let a change through. -->
    <profile>
      <id>coverage</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.jacoco</groupId>
            <artifactId>jacoco-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>coverage-desktop</id>
                <goals>
                  <goal>check</goal>
                </goals>
                <configuration>
                  <includes>
                    <include>nl/enadeag/carchargeplanner/desktop/**</include>
                  </includes>
                  <rules>
                    <rule>
                      <element>BUNDLE</element>
                      <limits>
                        <limit>
                          <counter>LINE</counter>
                          <value>COVEREDRATIO</value>
                          <minimum>0.95</minimum>
                        </limit>
                        <limit>
                          <counter>BRANCH</counter>
                          <value>COVEREDRATIO</value>
                          <minimum>0.82</minimum>
                        </limit>
                      </limits>
                    </rule>
                  </rules>
                </configuration>
              </execution>
              <execution>
                <id>coverage-instance</id>
                <goals>
                  <goal>check</goal>
                </goals>
                <configuration>
                  <includes>
                    <include>nl/enadeag/carchargeplanner/instance/**</include>
                  </includes>
                  <rules>
                    <rule>
                      <element>BUNDLE</element>
                      <limits>
                        <limit>
                          <counter>LINE</counter>
                          <value>COVEREDRATIO</value>
                          <minimum>0.88</minimum>
                        </limit>
                        <limit>
                          <counter>BRANCH</counter>
                          <value>COVEREDRATIO</value>
                          <minimum>0.74</minimum>
                        </limit>
                      </limits>
                    </rule>
                  </rules>
                </configuration>
              </execution>
              <execution>
                <id>coverage-root</id>
                <goals>
                  <goal>check</goal>
                </goals>
                <configuration>
                  <!-- the composition root's packages (the root package and start, cli, platforms, logging and
                       host), without the classes that wire the app -->
                  <includes>
                    <include>nl/enadeag/carchargeplanner/*.class</include>
                    <include>nl/enadeag/carchargeplanner/start/**</include>
                    <include>nl/enadeag/carchargeplanner/cli/**</include>
                    <include>nl/enadeag/carchargeplanner/platforms/**</include>
                    <include>nl/enadeag/carchargeplanner/logging/**</include>
                    <include>nl/enadeag/carchargeplanner/host/**</include>
                  </includes>
                  <excludes>
                    <exclude>nl/enadeag/carchargeplanner/Main*.class</exclude>
                    <exclude>nl/enadeag/carchargeplanner/start/DesktopApp*.class</exclude>
                    <exclude>nl/enadeag/carchargeplanner/host/Host*.class</exclude>
                    <exclude>nl/enadeag/carchargeplanner/platforms/*Parts*.class</exclude>
                  </excludes>
                  <rules>
                    <rule>
                      <element>BUNDLE</element>
                      <limits>
                        <limit>
                          <counter>LINE</counter>
                          <value>COVEREDRATIO</value>
                          <minimum>0.93</minimum>
                        </limit>
                        <limit>
                          <counter>BRANCH</counter>
                          <value>COVEREDRATIO</value>
                          <minimum>0.94</minimum>
                        </limit>
                      </limits>
                    </rule>
                  </rules>
                </configuration>
              </execution>
              <execution>
                <id>coverage-platform-linux</id>
                <goals>
                  <goal>check</goal>
                </goals>
                <configuration>
                  <includes>
                    <include>nl/enadeag/carchargeplanner/platform/linux/**</include>
                  </includes>
                  <rules>
                    <rule>
                      <element>BUNDLE</element>
                      <limits>
                        <limit>
                          <counter>LINE</counter>
                          <value>COVEREDRATIO</value>
                          <minimum>0.86</minimum>
                        </limit>
                        <limit>
                          <counter>BRANCH</counter>
                          <value>COVEREDRATIO</value>
                          <minimum>0.75</minimum>
                        </limit>
                      </limits>
                    </rule>
                  </rules>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>pit</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.pitest</groupId>
            <artifactId>pitest-maven</artifactId>
            <configuration>
              <jvmArgs combine.children="append">
                <value>--enable-native-access=ALL-UNNAMED</value>
                <value>-Dglass.platform=Headless</value>
                <value>-Dprism.order=sw</value>
              </jvmArgs>
            </configuration>
            <executions>
              <execution>
                <id>desktop</id>
                <configuration>
                  <skip>false</skip>
                  <!-- the classes that the tests without JavaFX (no @FxTest) cover: the mappers to the dashboard's
                       models, chart and popup geometry, the app settings, the logic of the Settings and set-up forms,
                       the tray icon's drawing, the text size and the texts -->
                  <targetClasses>
                    <param>nl.enadeag.carchargeplanner.desktop.app.AppSettings*</param>
                    <param>nl.enadeag.carchargeplanner.desktop.app.Background*</param>
                    <param>nl.enadeag.carchargeplanner.desktop.app.DisplayMode*</param>
                    <param>nl.enadeag.carchargeplanner.desktop.app.Units*</param>
                    <param>nl.enadeag.carchargeplanner.desktop.dashboard.PopupPlacement*</param>
                    <param>nl.enadeag.carchargeplanner.desktop.dashboard.advice.GridAdviceMapper*</param>
                    <param>nl.enadeag.carchargeplanner.desktop.dashboard.away.OneOffAwayCheck*</param>
                    <param>nl.enadeag.carchargeplanner.desktop.dashboard.away.OneOffAwayMapper*</param>
                    <param>nl.enadeag.carchargeplanner.desktop.dashboard.battery.BatteryMapper*</param>
                    <param>nl.enadeag.carchargeplanner.desktop.dashboard.battery.BatteryModel*</param>
                    <param>nl.enadeag.carchargeplanner.desktop.dashboard.day.DayMapper*</param>
                    <param>nl.enadeag.carchargeplanner.desktop.dashboard.outlook.OutlookMapper*</param>
                    <param>nl.enadeag.carchargeplanner.desktop.dashboard.solar.CurvePoints*</param>
                    <param>nl.enadeag.carchargeplanner.desktop.dashboard.solar.PlotArea*</param>
                    <param>nl.enadeag.carchargeplanner.desktop.dashboard.solar.SolarChartMapper*</param>
                    <param>nl.enadeag.carchargeplanner.desktop.dashboard.solar.SolarChartModel*</param>
                    <param>nl.enadeag.carchargeplanner.desktop.dashboard.tray.TrayStatusMapper*</param>
                    <param>nl.enadeag.carchargeplanner.desktop.dashboard.tray.TrayPresenter*</param>
                    <param>nl.enadeag.carchargeplanner.desktop.dashboard.trip.TripAdviceMapper*</param>
                    <param>nl.enadeag.carchargeplanner.desktop.dashboard.trip.TripAdviceModel*</param>
                    <param>nl.enadeag.carchargeplanner.desktop.dashboard.trip.TripCheck*</param>
                    <param>nl.enadeag.carchargeplanner.desktop.dashboard.trip.TripMapper*</param>
                    <param>nl.enadeag.carchargeplanner.desktop.dashboard.trip.TripOrigin*</param>
                    <param>nl.enadeag.carchargeplanner.desktop.dashboard.trip.TripsModel*</param>
                    <param>nl.enadeag.carchargeplanner.desktop.notify.*</param>
                    <param>nl.enadeag.carchargeplanner.desktop.settings.form.*</param>
                    <param>nl.enadeag.carchargeplanner.desktop.settings.page.WindowSize*</param>
                    <param>nl.enadeag.carchargeplanner.desktop.settings.setup.SetUpOffer*</param>
                    <param>nl.enadeag.carchargeplanner.desktop.system.StatusIcon*</param>
                    <param>nl.enadeag.carchargeplanner.desktop.system.TextSize</param>
                    <param>nl.enadeag.carchargeplanner.desktop.text.*</param>
                  </targetClasses>
                  <targetTests>
                    <param>nl.enadeag.carchargeplanner.desktop.*</param>
                  </targetTests>
                  <reportsDirectory>${project.build.directory}/pit-reports/desktop</reportsDirectory>
                  <!-- a few points below the share of mutants killed when it was set (92 %) -->
                  <mutationThreshold>89</mutationThreshold>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>

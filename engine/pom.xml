<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>nl.enadeag</groupId>
    <artifactId>car-charge-planner-parent</artifactId>
    <version>${revision}</version>
  </parent>

  <!-- The engine (ADR 0001, ADR 0010): the forecast, the plan, the notices and the files they are kept in, without a
       user interface, a desktop or a platform, so the desktop app and the Android app can share it. -->
  <artifactId>car-charge-planner-engine</artifactId>
  <name>Car charge planner engine</name>

  <dependencies>
    <dependency>
      <groupId>tools.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <dependency>
      <groupId>tools.jackson.core</groupId>
      <artifactId>jackson-core</artifactId>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-api</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-params</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-engine</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5-api</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5-engine</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- the engine's test classes as a jar of their own, for the test helpers the desktop's tests share:
           LogCapture, ManualScheduler, FakeProvider, SunnyDays, MemoryKeychain and LockableKeychain -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <executions>
          <execution>
            <id>test-helpers</id>
            <goals>
              <goal>test-jar</goal>
            </goals>
            <configuration>
              <!-- also with -Dmaven.test.skip=true, as in the Flatpak's build: then it is empty, but the desktop's
                   test-scope dependency on it still resolves -->
              <skip>false</skip>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- the engine's floors, from the engine's own tests (#263) -->
    <profile>
      <id>coverage</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.jacoco</groupId>
            <artifactId>jacoco-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>coverage-engine</id>
                <goals>
                  <goal>check</goal>
                </goals>
                <configuration>
                  <includes>
                    <include>nl/enadeag/carchargeplanner/engine/**</include>
                  </includes>
                  <rules>
                    <rule>
                      <element>BUNDLE</element>
                      <limits>
                        <limit>
                          <counter>LINE</counter>
                          <value>COVEREDRATIO</value>
                          <minimum>0.96</minimum>
                        </limit>
                        <limit>
                          <counter>BRANCH</counter>
                          <value>COVEREDRATIO</value>
                          <minimum>0.90</minimum>
                        </limit>
                      </limits>
                    </rule>
                  </rules>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>pit</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.pitest</groupId>
            <artifactId>pitest-maven</artifactId>
            <executions>
              <execution>
                <id>engine</id>
                <configuration>
                  <skip>false</skip>
                  <targetClasses>
                    <param>nl.enadeag.carchargeplanner.engine.*</param>
                  </targetClasses>
                  <targetTests>
                    <param>nl.enadeag.carchargeplanner.engine.*</param>
                  </targetTests>
                  <!-- the ArchUnit tests read the classes' structure, not what they do, so they kill no mutant -->
                  <excludedTestClasses>
                    <param>nl.enadeag.carchargeplanner.engine.*ArchitectureTest</param>
                  </excludedTestClasses>
                  <reportsDirectory>${project.build.directory}/pit-reports/engine</reportsDirectory>
                  <!-- a few points below the share of mutants killed when it was set (97 %) -->
                  <mutationThreshold>94</mutationThreshold>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
